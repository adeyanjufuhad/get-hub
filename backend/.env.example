# Server
PORT=8080
APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Neon Postgres (use the POOLED connection string for the app)
# Dev branch example:
DATABASE_URL=postgres://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/gethub_dev?sslmode=require

# Auth & JWT
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes-secret-key
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Google OAuth (optional in local dev — email+password works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must go through the FRONTEND origin (Next.js proxies it to the API) and must be
# listed exactly under "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback

# Content & Access Gating
# Keep true in dev so draft seed content is playable before publishing in /admin
INCLUDE_DRAFT_CONTENT=true
# Phase 1: false (everything accessible). Phase 3: switch to true to enforce Paystack subscriptions.
ENFORCE_PAID_GATING=false

# Local uploads directory (for admin SVG/PNG question images)
UPLOAD_DIR=./uploads
